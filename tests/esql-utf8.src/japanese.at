AT_SETUP([japanese])

AT_DATA([prog.cbl], [
       IDENTIFICATION              DIVISION.
      ******************************************************************
       PROGRAM-ID.                 prog.
      ******************************************************************
       DATA                        DIVISION.
      ******************************************************************
       WORKING-STORAGE             SECTION.
           EXEC SQL INCLUDE SQLCA END-EXEC.
       01 V PIC N(5).

       01  TEST-DATA.
         03 FILLER  PIC N(5) VALUE "あいうえお".
         03 FILLER  PIC N(5) VALUE "ａｂｃｄｅ".
         03 FILLER  PIC N(5) VALUE "１２３４５".
         03 FILLER  PIC N(5) VALUE "プログラム".
         03 FILLER  PIC N(5) VALUE "ＡＢＣＤＥ".
         03 FILLER  PIC N(5) VALUE "！＃＄％＆".
         03 FILLER  PIC N(5) VALUE "日本語漢字".
         03 FILLER  PIC N(5) VALUE "＠｛｝＊＋".
         03 FILLER  PIC N(5) VALUE "＿？＞＜，".
         03 FILLER  PIC N(5) VALUE "日本＞＜，".

       01  TEST-DATA-R   REDEFINES TEST-DATA.
         03  TEST-TBL    OCCURS  10.
           05  D             PIC N(5).

       01  IDX                     PIC  S9(02) .
       01 LOG-COUNT PIC 9999 VALUE 1.

       01 READ-DATA-TBL.
         03  READ-TBL    OCCURS  10.
           05  READ-DATA     PIC N(5).

       01  DBNAME                  PIC  X(30) VALUE SPACE.
       01  USERNAME                PIC  X(30) VALUE SPACE.
       01  PASSWD                  PIC  X(10) VALUE SPACE.

      ******************************************************************
       PROCEDURE                   DIVISION.
      ******************************************************************
       MAIN-RTN.

       PERFORM SETUP-DB.

      *    SHOW RESULT
           EXEC SQL
               SELECT FIELD INTO :READ-TBL FROM TT_UJAPANESE ORDER BY N
           END-EXEC.

           PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > 10
               DISPLAY READ-DATA(IDX)
           END-PERFORM.

       PERFORM CLEANUP-DB.

      *    END
           STOP RUN.

      ******************************************************************
       SETUP-DB.
      ******************************************************************

      *    SERVER
           MOVE  "<|DB_NAME|>@<|DB_HOST|>:<|DB_PORT|>"
             TO DBNAME.
           MOVE  "<|DB_USER|>"
             TO USERNAME.
           MOVE  "<|DB_PASSWORD|>"
             TO PASSWD.

           EXEC SQL
               CONNECT :USERNAME IDENTIFIED BY :PASSWD USING :DBNAME
           END-EXEC.

           EXEC SQL
               DROP TABLE IF EXISTS TT_UJAPANESE
           END-EXEC.

           EXEC SQL
                CREATE TABLE TT_UJAPANESE
                (
                    N         NUMERIC(2,0) NOT NULL,
                    FIELD     CHAR(10)
                )
           END-EXEC.

      *    INSERT ROWS USING HOST VARIABLE
           PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > 10
              MOVE D(IDX)     TO  V
              EXEC SQL
                 INSERT INTO TT_UJAPANESE VALUES (:IDX, :V)
              END-EXEC
           END-PERFORM.

      *    COMMIT
           EXEC SQL
               COMMIT WORK
           END-EXEC.

      ******************************************************************
       CLEANUP-DB.
      ******************************************************************
      *    EXEC SQL
      *        DROP TABLE IF EXISTS TT_UJAPANESE
      *    END-EXEC.

           EXEC SQL
               DISCONNECT ALL
           END-EXEC.


])

AT_CHECK([${EMBED_DB_INFO} prog.cbl])
AT_CHECK([${COMPILE_MODULE} prog.cbl])
AT_CHECK([COB_TERMINAL_ENCODING=UTF8 ${RUN_MODULE} prog], [0],
[あいうえお
ａｂｃｄｅ
１２３４５
プログラム
ＡＢＣＤＥ
！＃＄％＆
日本語漢字
＠｛｝＊＋
＿？＞＜，
日本＞＜，
])

AT_CLEANUP
