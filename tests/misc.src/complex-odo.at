AT_SETUP([OCCURS DEPENDING ON with complex-odo (multiple fields after)])

AT_DATA([test.conf], [
include "default.conf"

name: "test"

complex-odo: yes
])

AT_DATA([prog.cbl], [
        IDENTIFICATION DIVISION.
        PROGRAM-ID. prog.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  T-REC.
            02  T-ODO-COUNT     PIC 9(8) BINARY.
            02  T-ODO-ITEM      OCCURS 10 DEPENDING ON T-ODO-COUNT
                                PIC X(2).
            02  T-AFTER-ODO1    PIC S9(004) COMP.
            02  T-AFTER-ODO2    PIC S9(004) COMP.
            02  T-AFTER-ODO3    PIC X(5).
        PROCEDURE DIVISION.
            MOVE 0 TO T-ODO-COUNT.
            MOVE 5 TO T-AFTER-ODO1.
            MOVE 10 TO T-AFTER-ODO2.
            MOVE "ABCDE" TO T-AFTER-ODO3.
            DISPLAY T-AFTER-ODO1.
            DISPLAY T-AFTER-ODO2.
            DISPLAY T-AFTER-ODO3.
            MOVE 7 TO T-ODO-COUNT.
            MOVE 20 TO T-AFTER-ODO1.
            MOVE 30 TO T-AFTER-ODO2.
            MOVE "FGHIJ" TO T-AFTER-ODO3.
            DISPLAY T-AFTER-ODO1.
            DISPLAY T-AFTER-ODO2.
            DISPLAY T-AFTER-ODO3.
            STOP RUN.
])

AT_CHECK([${COBJ} -conf=test.conf prog.cbl], [0])
AT_CHECK([${RUN_MODULE} prog], [0],
[+0005
+0010
ABCDE
+0020
+0030
FGHIJ
])

AT_CLEANUP

