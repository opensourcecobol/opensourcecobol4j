AT_SETUP([OCCURS DEPENDING ON with complex-odo (simple)])

AT_DATA([test.conf], [
include "default.conf"

name: "test"

complex-odo: yes
])

AT_DATA([prog.cbl], [
        IDENTIFICATION DIVISION.
        PROGRAM-ID. prog.
        DATA DIVISION.
        WORKING-STORAGE SECTION.
        01  T-REC.
            02  T-ODO-COUNT     PIC 9(8) BINARY.
            02  T-ODO-ITEM      OCCURS 227 DEPENDING ON T-ODO-COUNT
                                PIC X(2).
            02  T-AFTER-ODO     PIC S9(004) COMP.
        PROCEDURE DIVISION.
            MOVE 0 TO T-ODO-COUNT.
            MOVE 5 TO T-AFTER-ODO.
            DISPLAY T-AFTER-ODO.
            MOVE 10 TO T-ODO-COUNT.
            MOVE 20 TO T-AFTER-ODO.
            DISPLAY T-AFTER-ODO.
            STOP RUN.
])

AT_CHECK([${COBJ} -conf=test.conf prog.cbl], [0])
AT_CHECK([${RUN_MODULE} prog], [0],
[+0005
+0020
])

AT_CLEANUP

