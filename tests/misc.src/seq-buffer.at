AT_SETUP([COB_FILE_SEQ_BUFFER_SIZE: LINE SEQUENTIAL read with short records])

AT_DATA([prog.cbl], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       ENVIRONMENT      DIVISION.
       INPUT-OUTPUT     SECTION.
       FILE-CONTROL.
       SELECT TEST-FILE ASSIGN "TESTSHRT"
           ORGANIZATION LINE SEQUENTIAL.
       DATA             DIVISION.
       FILE             SECTION.
       FD TEST-FILE.
       01 TEST-REC      PIC X(20).
       PROCEDURE        DIVISION.
           OPEN OUTPUT TEST-FILE.
           MOVE "AB" TO TEST-REC.
           WRITE TEST-REC.
           MOVE "CDEFGHIJ" TO TEST-REC.
           WRITE TEST-REC.
           MOVE "K" TO TEST-REC.
           WRITE TEST-REC.
           CLOSE TEST-FILE.

           OPEN INPUT TEST-FILE.
           READ TEST-FILE.
           DISPLAY ">" TEST-REC "<".
           READ TEST-FILE.
           DISPLAY ">" TEST-REC "<".
           READ TEST-FILE.
           DISPLAY ">" TEST-REC "<".
           CLOSE TEST-FILE.
           STOP RUN.
])

AT_CHECK([${COMPILE} prog.cbl])
AT_CHECK([COB_FILE_SEQ_BUFFER_SIZE=2 ${RUN_MODULE} prog], [0],
[>AB                  <
>CDEFGHIJ            <
>K                   <
])

AT_CLEANUP
