           READ TEST-FILE.
           DISPLAY TEST-REC.
           MOVE "UPD6" TO TEST-REC.
           REWRITE TEST-REC.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           CLOSE TEST-FILE.

           OPEN INPUT TEST-FILE.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           CLOSE TEST-FILE.
           STOP RUN.
])

AT_CHECK([${COMPILE} prog.cbl])
