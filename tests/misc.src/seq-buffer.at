           READ TEST-FILE.
           DISPLAY TEST-REC.
           MOVE "UPD1" TO TEST-REC.
           REWRITE TEST-REC.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           MOVE "UPD3" TO TEST-REC.
           REWRITE TEST-REC.
