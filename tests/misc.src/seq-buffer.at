           DISPLAY TEST-REC.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           READ TEST-FILE.
           DISPLAY TEST-REC.
