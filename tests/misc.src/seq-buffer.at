       PROCEDURE        DIVISION.
           OPEN OUTPUT TEST-FILE.
           MOVE "REC1" TO TEST-REC.
           WRITE TEST-REC.
           MOVE "REC2" TO TEST-REC.
           WRITE TEST-REC.
           MOVE "REC3" TO TEST-REC.
