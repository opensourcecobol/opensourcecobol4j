AT_SETUP([COB_FILE_SEQ_BUFFER_SIZE: SEQUENTIAL read])

AT_DATA([prog.cbl], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       ENVIRONMENT      DIVISION.
       INPUT-OUTPUT     SECTION.
       FILE-CONTROL.
       SELECT TEST-FILE ASSIGN "TESTSEQ"
           ORGANIZATION SEQUENTIAL.
       DATA             DIVISION.
       FILE             SECTION.
       FD TEST-FILE.
       01 TEST-REC      PIC X(4).
       PROCEDURE        DIVISION.
           OPEN OUTPUT TEST-FILE.
           MOVE "AAAA" TO TEST-REC.
           WRITE TEST-REC.
           MOVE "BBBB" TO TEST-REC.
           WRITE TEST-REC.
           MOVE "CCCC" TO TEST-REC.
           WRITE TEST-REC.
           CLOSE TEST-FILE.

           OPEN INPUT TEST-FILE.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           READ TEST-FILE.
           DISPLAY TEST-REC.
           CLOSE TEST-FILE.
           STOP RUN.
])

AT_CHECK([${COMPILE} prog.cbl])
AT_CHECK([COB_FILE_SEQ_BUFFER_SIZE=10 ${RUN_MODULE} prog], [0],
[AAAA
BBBB
CCCC
])

AT_CLEANUP


