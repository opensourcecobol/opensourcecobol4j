    5 |        SECTION-A SECTION.
    6 >        L.
    7 |       *No Label
    8 |        L.
])
AT_CHECK([${COMPILE} -fsyntax-only prog3.cob])

AT_CHECK([${COMPILE} prog1.cob], [1], ,
[prog1.cob:8: Error: Duplicate paragraph 'L' in the default section
    6 |        L.
    7 |       *No Label
    8 >        L.
    9 |            STOP RUN.
prog1.cob:6: Error: 'L' previously defined here
