    4 |        PROCEDURE        DIVISION.
    5 >            GO TO END-OF-PROGRAM.
    6 |            STOP RUN.
])

AT_CLEANUP


## Redefinition

AT_SETUP([Redefinition of section names])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       PROCEDURE        DIVISION.
       L SECTION.
       L SECTION.
           STOP RUN.
])

AT_CHECK([${COMPILE_ONLY} prog.cob], [1], ,
[prog.cob: In section 'L':
prog.cob:6: Error: Redefinition of 'L'
    4 |        PROCEDURE        DIVISION.
    5 |        L SECTION.
    6 >        L SECTION.
    7 |            STOP RUN.
prog.cob:5: Error: 'L' previously defined here
    3 |        PROGRAM-ID.      prog.
    4 |        PROCEDURE        DIVISION.
    5 >        L SECTION.
    6 |        L SECTION.
    7 |            STOP RUN.
])

AT_CLEANUP

AT_SETUP([Redefinition of section and paragraph names])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       PROCEDURE        DIVISION.
       L SECTION.
       L.
           STOP RUN.
])

