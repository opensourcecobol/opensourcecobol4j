AT_CLEANUP

AT_SETUP([Redefinition of 88 items])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01 X             PIC X.
         88 A           VALUE "A".
         88 A           VALUE "B".
])

AT_CHECK([${COMPILE_ONLY} prog.cob], [0], ,
[prog.cob:8: Warning: Redefinition of 'A'
    6 |        01 X             PIC X.
    7 |          88 A           VALUE "A".
    8 >          88 A           VALUE "B".
prog.cob:7: Warning: 'A' previously defined here
    5 |        WORKING-STORAGE  SECTION.
    6 |        01 X             PIC X.
    7 >          88 A           VALUE "A".
    8 |          88 A           VALUE "B".
])

AT_CLEANUP

AT_SETUP([Ambiguous reference to 02 items])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01 G1.
         02 X           PIC X.
       01 G2.
         02 X           PIC X.
       PROCEDURE        DIVISION.
           DISPLAY X
           END-DISPLAY.
           STOP RUN.
])

AT_CHECK([${COMPILE_ONLY} prog.cob], [1], ,
[prog.cob:11: Error: 'X' ambiguous; need qualification
    9 |          02 X           PIC X.
   10 |        PROCEDURE        DIVISION.
   11 >            DISPLAY X
   12 |            END-DISPLAY.
   13 |            STOP RUN.
prog.cob:7: Error: 'X' in 'G1' defined here
    5 |        WORKING-STORAGE  SECTION.
    6 |        01 G1.
    7 >          02 X           PIC X.
    8 |        01 G2.
    9 |          02 X           PIC X.
prog.cob:9: Error: 'X' in 'G2' defined here
    7 |          02 X           PIC X.
    8 |        01 G2.
    9 >          02 X           PIC X.
   10 |        PROCEDURE        DIVISION.
   11 |            DISPLAY X
])

AT_CLEANUP

AT_SETUP([Ambiguous reference to 02 and 03 items])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01 G.
         02 X.
           03 X         PIC X.
       PROCEDURE        DIVISION.
           DISPLAY X
           END-DISPLAY.
           STOP RUN.
])

AT_CHECK([${COMPILE_ONLY} prog.cob], [1], ,
[prog.cob:10: Error: 'X' ambiguous; need qualification
    8 |            03 X         PIC X.
    9 |        PROCEDURE        DIVISION.
   10 >            DISPLAY X
   11 |            END-DISPLAY.
   12 |            STOP RUN.
prog.cob:7: Error: 'X' in 'G' defined here
    5 |        WORKING-STORAGE  SECTION.
    6 |        01 G.
    7 >          02 X.
    8 |            03 X         PIC X.
    9 |        PROCEDURE        DIVISION.
prog.cob:8: Error: 'X' in 'X' in 'G' defined here
    6 |        01 G.
    7 |          02 X.
    8 >            03 X         PIC X.
    9 |        PROCEDURE        DIVISION.
   10 |            DISPLAY X
])

AT_CLEANUP

AT_SETUP([Ambiguous reference with qualification])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01 G1.
         02 X.
           03 Y         PIC X.
       01 G2.
         02 X.
           03 Y         PIC X.
       PROCEDURE        DIVISION.
           DISPLAY Y OF X
           END-DISPLAY.
           STOP RUN.
])

AT_CHECK([${COMPILE_ONLY} prog.cob], [1], ,
[prog.cob:13: Error: 'Y' in 'X' ambiguous; need qualification
   11 |            03 Y         PIC X.
   12 |        PROCEDURE        DIVISION.
   13 >            DISPLAY Y OF X
   14 |            END-DISPLAY.
   15 |            STOP RUN.
prog.cob:8: Error: 'Y' in 'X' in 'G1' defined here
    6 |        01 G1.
    7 |          02 X.
    8 >            03 Y         PIC X.
    9 |        01 G2.
   10 |          02 X.
prog.cob:11: Error: 'Y' in 'X' in 'G2' defined here
    9 |        01 G2.
   10 |          02 X.
   11 >            03 Y         PIC X.
   12 |        PROCEDURE        DIVISION.
   13 |            DISPLAY Y OF X
])

AT_CLEANUP



AT_SETUP([Unique reference with ambiguous qualifiers])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01 G1.
         02 X.
           03 Y         PIC X VALUE "Y".
       01 G2.
         02 X.
           03 Z         PIC X VALUE "Z".
       PROCEDURE        DIVISION.
           DISPLAY Z OF X NO ADVANCING
           END-DISPLAY.
           STOP RUN.
])

AT_CHECK([${COMPILE_ONLY} prog.cob], [0])

AT_CLEANUP


AT_SETUP([Omit para/sect label names in ref check msg.])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       PROCEDURE        DIVISION.
         L0. GO TO L1.
         L1. GOBACK.
         L1. GOBACK.
         L2. STOP RUN.
])

AT_CHECK([${COMPILE_ONLY} prog.cob], [1], ,
[prog.cob:6: Error: 'L1' ambiguous; need qualification
    4 |        DATA             DIVISION.
    5 |        PROCEDURE        DIVISION.
    6 >          L0. GO TO L1.
    7 |          L1. GOBACK.
    8 |          L1. GOBACK.
prog.cob:7: Error: 'L1' in 'MAIN SECTION' defined here
    5 |        PROCEDURE        DIVISION.
    6 |          L0. GO TO L1.
    7 >          L1. GOBACK.
    8 |          L1. GOBACK.
    9 |          L2. STOP RUN.
prog.cob:8: Error: 'L1' in 'MAIN SECTION' defined here
    6 |          L0. GO TO L1.
    7 |          L1. GOBACK.
    8 >          L1. GOBACK.
    9 |          L2. STOP RUN.
])

AT_CLEANUP

