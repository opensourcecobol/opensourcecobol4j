    6 >        L.
    7 |            STOP RUN.
prog.cob:5: Error: 'L' previously defined here
    3 |        PROGRAM-ID.      prog.
    4 |        PROCEDURE        DIVISION.
    5 >        L SECTION.
    6 |        L.
    7 |            STOP RUN.
])

AT_CLEANUP

AT_SETUP([Redefinition of paragraph names])

AT_DATA([prog1.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog1.
       PROCEDURE        DIVISION.
      *No Label
       L.
      *No Label
       L.
           STOP RUN.
])

AT_DATA([prog2.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog2.
       PROCEDURE        DIVISION.
       SECTION-A SECTION.
       L.
      *No Label
       L.
           STOP RUN.
])

AT_DATA([prog3.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog3.
       PROCEDURE        DIVISION.
       SECTION-A SECTION.
       L.
       SECTION-B SECTION.
       L.
           STOP RUN.
])

AT_CHECK([${COMPILE} -fsyntax-only prog1.cob], [1], ,
[prog1.cob:8: Error: Duplicate paragraph 'L' in the default section
    6 |        L.
    7 |       *No Label
    8 >        L.
    9 |            STOP RUN.
prog1.cob:6: Error: 'L' previously defined here
    4 |        PROCEDURE        DIVISION.
    5 |       *No Label
    6 >        L.
    7 |       *No Label
    8 |        L.
])
