AT_SETUP([parse-error recovery after Headings.])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  Z  PIC 9.
       PROCEDURE        DIVISION.
       S00 SECTION SECTION
           IF Z = 0 THEN
               DISPLAY Z UPON NOWHERE
               DISPLAY ZZ UPON CONSOLE
           END-IF.
])

