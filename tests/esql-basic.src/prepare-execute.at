AT_SETUP([prepare and execute statement test])

AT_DATA([prog.cbl], [
       IDENTIFICATION              DIVISION.
      ******************************************************************
       PROGRAM-ID.                 prog.
      ******************************************************************
       DATA                        DIVISION.
      ******************************************************************
       WORKING-STORAGE             SECTION.
           EXEC SQL INCLUDE SQLCA END-EXEC.
       01  TEST-DATA.
         03 FILLER       PIC X(28) VALUE "0001北海　太郎          0400".
         03 FILLER       PIC X(28) VALUE "0002青森　次郎          0350".
         03 FILLER       PIC X(28) VALUE "0003秋田　三郎          0300".
         03 FILLER       PIC X(28) VALUE "0004岩手　四郎          025p".
         03 FILLER       PIC X(28) VALUE "0005宮城　五郎          020p".
         03 FILLER       PIC X(28) VALUE "0006福島　六郎          0150".
         03 FILLER       PIC X(28) VALUE "0007栃木　七郎          010p".
         03 FILLER       PIC X(28) VALUE "0008茨城　八郎          0050".
         03 FILLER       PIC X(28) VALUE "0009群馬　九郎          020p".
         03 FILLER       PIC X(28) VALUE "0010埼玉　十郎          0350".

       01  TEST-DATA-R   REDEFINES TEST-DATA.
         03  TEST-TBL    OCCURS  10.
           05  TEST-NO             PIC S9(04).
           05  TEST-NAME           PIC  X(20) .
           05  TEST-SALARY         PIC S9(04).
       01  IDX                     PIC  9(02).
       01 LOG-COUNT PIC 9999 VALUE 1.

       01 SQL-COMMAND PIC X(50) VARYING.
       01 SQL-COMMAND-ARG PIC 99 VALUE 5.

       01  DBNAME                  PIC  X(30) VALUE SPACE.
       01  USERNAME                PIC  X(30) VALUE SPACE.
       01  PASSWD                  PIC  X(10) VALUE SPACE.

       01  EMP-REC-VARS.
         03  EMP-NO                PIC S9(04) VALUE ZERO.
         03  EMP-NAME              PIC  X(20) .
         03  EMP-SALARY            PIC S9(04) VALUE ZERO.

      ******************************************************************
       PROCEDURE                   DIVISION.
      ******************************************************************
       MAIN-RTN.
           
       PERFORM SETUP-DB.

      *    Set the VARYING host variable (SQL text + length)
           MOVE "DELETE FROM EMP_PREPEXEC1 WHERE EMP_NO > ?"
             TO SQL-COMMAND-ARR.
           MOVE 42 TO SQL-COMMAND-LEN.

      *    PREPARE
           EXEC SQL
               PREPARE st FROM :SQL-COMMAND
           END-EXEC.
           PERFORM OUTPUT-RETURN-CODE-TEST.

      *    EXECUTE
           EXEC SQL
               EXECUTE st USING :SQL-COMMAND-ARG
           END-EXEC.
           PERFORM OUTPUT-RETURN-CODE-TEST.

      *    DECLARE CURSOR
           EXEC SQL 
               DECLARE C1 CURSOR FOR
               SELECT EMP_NO, EMP_NAME, EMP_SALARY 
                      FROM EMP_PREPEXEC1
                      ORDER BY EMP_NO
           END-EXEC.

      *    OPEN CURSOR
           EXEC SQL
               OPEN C1
           END-EXEC.

           EXEC SQL 
               FETCH C1 INTO :EMP-NO, :EMP-NAME, :EMP-SALARY
           END-EXEC.
           PERFORM UNTIL SQLCODE NOT = ZERO

              DISPLAY LOG-COUNT " <log> success fetch_record "
                      EMP-NO ", " EMP-NAME ", " EMP-SALARY
              ADD 1 TO LOG-COUNT
              EXEC SQL 
                  FETCH C1 INTO :EMP-NO, :EMP-NAME, :EMP-SALARY
              END-EXEC
           END-PERFORM.

       PERFORM CLEANUP-DB.

      *    END
           STOP RUN.

      ******************************************************************
       SETUP-DB.
      ******************************************************************

      *    SERVER
           MOVE  "<|DB_NAME|>@<|DB_HOST|>:<|DB_PORT|>"
             TO DBNAME.
           MOVE  "<|DB_USER|>"
             TO USERNAME.
           MOVE  "<|DB_PASSWORD|>"
             TO PASSWD.

           EXEC SQL
               CONNECT :USERNAME IDENTIFIED BY :PASSWD USING :DBNAME 
           END-EXEC.

           EXEC SQL
               DROP TABLE IF EXISTS EMP_PREPEXEC1
           END-EXEC.

           EXEC SQL
                CREATE TABLE EMP_PREPEXEC1
                (
                    EMP_NO     NUMERIC(4,0) NOT NULL,
                    EMP_NAME   CHAR(20),
                    EMP_SALARY NUMERIC(4,0),
                    CONSTRAINT IEMP_PREPEXEC1 PRIMARY KEY (EMP_NO)
                )
           END-EXEC.

      *    INSERT ROWS USING HOST VARIABLE
           PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > 10
              MOVE TEST-NO(IDX)     TO  EMP-NO
              MOVE TEST-NAME(IDX)   TO  EMP-NAME
              MOVE TEST-SALARY(IDX) TO  EMP-SALARY
              EXEC SQL
                 INSERT INTO EMP_PREPEXEC1 VALUES
                        (:EMP-NO,:EMP-NAME,:EMP-SALARY)
              END-EXEC
           END-PERFORM.

      ******************************************************************
       CLEANUP-DB.
      ******************************************************************
           EXEC SQL
               CLOSE C1
           END-EXEC.

           EXEC SQL
               DROP TABLE IF EXISTS EMP_PREPEXEC1
           END-EXEC.

           EXEC SQL
               DISCONNECT ALL
           END-EXEC.

      ******************************************************************
       OUTPUT-RETURN-CODE-TEST.
      ******************************************************************
           IF  SQLCODE = ZERO
             THEN

               DISPLAY LOG-COUNT " <log> success test_return_code"

             ELSE
               DISPLAY LOG-COUNT " <log> fail test_return_code    "
                   NO ADVANCING
               DISPLAY "SQLCODE=" SQLCODE " ERRCODE="  SQLSTATE " "
                   NO ADVANCING
               EVALUATE SQLCODE
                  WHEN  +10
                     DISPLAY "Record_not_found"
                  WHEN  -01
                     DISPLAY "Connection_falied"
                  WHEN  -20
                     DISPLAY "Internal_error"
                  WHEN  -30
                     DISPLAY "PostgreSQL_error" NO ADVANCING
                     DISPLAY SQLERRMC
                  *> TO RESTART TRANSACTION, DO ROLLBACK.
                     EXEC SQL
                         ROLLBACK
                     END-EXEC
                  WHEN  OTHER
                     DISPLAY "Undefined_error" NO ADVANCING
                     DISPLAY SQLERRMC
               END-EVALUATE.
           
           ADD 1 TO LOG-COUNT.
      ******************************************************************

])
AT_CHECK([${EMBED_DB_INFO} prog.cbl])
AT_CHECK([${COMPILE_MODULE} prog.cbl])
AT_CHECK([${RUN_MODULE} prog], [0],
[0001 <log> success test_return_code
0002 <log> success test_return_code
0003 <log> success fetch_record +0001, 北海　太郎          , +0400
0004 <log> success fetch_record +0002, 青森　次郎          , +0350
0005 <log> success fetch_record +0003, 秋田　三郎          , +0300
0006 <log> success fetch_record +0004, 岩手　四郎          , -0250
0007 <log> success fetch_record +0005, 宮城　五郎          , -0200
])
AT_CLEANUP

AT_SETUP([prepare with fixed-length PIC X(n) host variable (no VARYING)])

AT_DATA([prog.cbl], [
       IDENTIFICATION              DIVISION.
       PROGRAM-ID.                 prog.
       DATA                        DIVISION.
       WORKING-STORAGE             SECTION.
           EXEC SQL INCLUDE SQLCA END-EXEC.
      *    Non-VARYING fixed-length host variable for PREPARE.
      *    A plain PIC X(n) must work: prepare reads the whole field
      *    and trims trailing spaces.
       01  SQL-COMMAND   PIC X(50)
            VALUE "DELETE FROM EMP_PREPEXEC2 WHERE EMP_NO > ?".
       01  SQL-COMMAND-ARG         PIC  99 VALUE 5.
       01  DBNAME                  PIC  X(30) VALUE SPACE.
       01  USERNAME                PIC  X(30) VALUE SPACE.
       01  PASSWD                  PIC  X(10) VALUE SPACE.
       01  EMP-NO                  PIC S9(04) VALUE ZERO.
       01  EMP-NAME                PIC  X(20).
       01  EMP-SALARY              PIC S9(04) VALUE ZERO.
       01  IDX                     PIC  9(02).
       PROCEDURE                   DIVISION.
       MAIN-RTN.
           MOVE "<|DB_NAME|>@<|DB_HOST|>:<|DB_PORT|>" TO DBNAME.
           MOVE "<|DB_USER|>" TO USERNAME.
           MOVE "<|DB_PASSWORD|>" TO PASSWD.
           EXEC SQL
               CONNECT :USERNAME IDENTIFIED BY :PASSWD USING :DBNAME
           END-EXEC.
           EXEC SQL DROP TABLE IF EXISTS EMP_PREPEXEC2 END-EXEC.
           EXEC SQL
               CREATE TABLE EMP_PREPEXEC2 (EMP_NO NUMERIC(4,0) NOT NULL,
               EMP_NAME CHAR(20), EMP_SALARY NUMERIC(4,0))
           END-EXEC.
           PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > 10
              MOVE IDX TO EMP-NO
              MOVE "NAME" TO EMP-NAME
              COMPUTE EMP-SALARY = IDX * 100
              EXEC SQL
                 INSERT INTO EMP_PREPEXEC2 VALUES
                        (:EMP-NO,:EMP-NAME,:EMP-SALARY)
              END-EXEC
           END-PERFORM.
           EXEC SQL COMMIT WORK END-EXEC.
      *    PREPARE from the plain PIC X(n) host variable
           EXEC SQL PREPARE st FROM :SQL-COMMAND END-EXEC.
           DISPLAY "PREPARE SQLCODE=" SQLCODE.
           EXEC SQL EXECUTE st USING :SQL-COMMAND-ARG END-EXEC.
           DISPLAY "EXECUTE SQLCODE=" SQLCODE.
           EXEC SQL DROP TABLE IF EXISTS EMP_PREPEXEC2 END-EXEC.
           EXEC SQL DISCONNECT ALL END-EXEC.
           STOP RUN.
])
AT_CHECK([${EMBED_DB_INFO} prog.cbl])
AT_CHECK([${COMPILE_MODULE} prog.cbl])
AT_CHECK([${RUN_MODULE} prog], [0],
[PREPARE SQLCODE=+000000000
EXECUTE SQLCODE=+000000000
])
AT_CLEANUP
