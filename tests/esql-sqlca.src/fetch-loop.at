AT_SETUP([fetch loop])

AT_DATA([prog.cbl], [
       IDENTIFICATION              DIVISION.
      ******************************************************************
       PROGRAM-ID.                 prog.
      ******************************************************************
       DATA                        DIVISION.
      ******************************************************************
       WORKING-STORAGE             SECTION.
           EXEC SQL INCLUDE SQLCA END-EXEC.
       01  TEST-DATA.
         03 FILLER       PIC X(28) VALUE "0001北海　太郎          0400".
         03 FILLER       PIC X(28) VALUE "0002青森　次郎          0350".
         03 FILLER       PIC X(28) VALUE "0003秋田　三郎          0300".
         03 FILLER       PIC X(28) VALUE "0004岩手　四郎          025p".
         03 FILLER       PIC X(28) VALUE "0005宮城　五郎          020p".
         03 FILLER       PIC X(28) VALUE "0006福島　六郎          0150".
         03 FILLER       PIC X(28) VALUE "0007栃木　七郎          010p".
         03 FILLER       PIC X(28) VALUE "0008茨城　八郎          0050".
         03 FILLER       PIC X(28) VALUE "0009群馬　九郎          020p".
         03 FILLER       PIC X(28) VALUE "0010埼玉　十郎          0350".

       01  TEST-DATA-R   REDEFINES TEST-DATA.
         03  TEST-TBL    OCCURS  10.
           05  TEST-NO             PIC S9(04).
           05  TEST-NAME           PIC  X(20) .
           05  TEST-SALARY         PIC S9(04).
       01  IDX                     PIC  9(02).
       01 TEST-CASE-COUNT PIC 9999 VALUE 1.

       01  DBNAME                  PIC  X(30) VALUE SPACE.
       01  USERNAME                PIC  X(30) VALUE SPACE.
       01  PASSWD                  PIC  X(10) VALUE SPACE.

       01  EMP-REC-VARS.
         03  EMP-NO                PIC S9(04) VALUE ZERO.
         03  EMP-NAME              PIC  X(20) .
         03  EMP-SALARY            PIC S9(04) VALUE ZERO.

      ******************************************************************
       PROCEDURE                   DIVISION.
      ******************************************************************
       MAIN-RTN.
           
       PERFORM SETUP-DB.

           EXEC SQL 
               DECLARE C1 CURSOR FOR
               SELECT EMP_NO, EMP_NAME, EMP_SALARY 
                      FROM EMP_FETCHLOOP
                      WHERE EMP_SALARY > 0
                      ORDER BY EMP_NO
           END-EXEC.
           DISPLAY "<declare(valid)> SQLCODE:" SQLCODE

           EXEC SQL
               OPEN C1
           END-EXEC.
           DISPLAY "<open(valid)> SQLCODE:" SQLCODE

           EXEC SQL 
               FETCH C1 INTO :EMP-NO, :EMP-NAME, :EMP-SALARY
           END-EXEC
           DISPLAY "<fetch(valid)> SQLCODE:" SQLCODE
           PERFORM UNTIL SQLCODE NOT = 0
             DISPLAY "<data(valid)> " EMP-NO ", " EMP-SALARY
             EXEC SQL 
                 FETCH C1 INTO :EMP-NO, :EMP-NAME, :EMP-SALARY
             END-EXEC
             DISPLAY "<fetch(valid)> SQLCODE:" SQLCODE
           END-PERFORM.

           EXEC SQL
               CLOSE C1
           END-EXEC.
           DISPLAY "<close(valid)> SQLCODE:" SQLCODE

      *    The result of FETCH is Empty
           EXEC SQL 
               DECLARE C2 CURSOR FOR
               SELECT EMP_NO, EMP_NAME, EMP_SALARY 
                      FROM EMP_FETCHLOOP
                      WHERE EMP_SALARY = 9999
                      ORDER BY EMP_NO
           END-EXEC.
           DISPLAY "<declare(empty)> SQLCODE:" SQLCODE

           EXEC SQL
               OPEN C2
           END-EXEC.
           DISPLAY "<open(empty)> SQLCODE:" SQLCODE

           EXEC SQL 
               FETCH C2 INTO :EMP-NO, :EMP-NAME, :EMP-SALARY
           END-EXEC
           DISPLAY "<fetch(empty)> SQLCODE:" SQLCODE
           PERFORM UNTIL SQLCODE NOT = 0
             DISPLAY "<data(empty)> " EMP-NO ", " EMP-SALARY
             EXEC SQL 
                 FETCH C2 INTO :EMP-NO, :EMP-NAME, :EMP-SALARY
             END-EXEC
             DISPLAY "<fetch(empty)> SQLCODE:" SQLCODE
           END-PERFORM.

           EXEC SQL
               CLOSE C2
           END-EXEC.
           DISPLAY "<close(empty)> SQLCODE:" SQLCODE

      *    INVALID Cursor
           EXEC SQL 
               DECLARE C3 CURSOR FOR
               SELECT EMP_NO, EMP_NAME, EMP_SALARY 
                      FROM EMP_FETCHLOOP
                      ++++WHERE++++ EMP_SALARY > 0
                      ORDER BY EMP_NO
           END-EXEC.
           DISPLAY "<declare(invalid)> SQLCODE:" SQLCODE.

           EXEC SQL
               OPEN C3
           END-EXEC.
           DISPLAY "<open(invalid)> SQLCODE:" SQLCODE.

           EXEC SQL 
               FETCH C3 INTO :EMP-NO, :EMP-NAME, :EMP-SALARY
           END-EXEC
           DISPLAY "<fetch(invalid)> SQLCODE:" SQLCODE
           PERFORM UNTIL SQLCODE NOT = 0
             DISPLAY "<data(invalid)> " EMP-NO ", " EMP-SALARY
             EXEC SQL 
                 FETCH C3 INTO :EMP-NO, :EMP-NAME, :EMP-SALARY
             END-EXEC
             DISPLAY "<fetch(invalid)> SQLCODE:" SQLCODE
           END-PERFORM.

           EXEC SQL
               CLOSE C3
           END-EXEC.
           DISPLAY "<close(invalid)> SQLCODE:" SQLCODE

       PERFORM CLEANUP-DB.

      *    END
           STOP RUN.

      ******************************************************************
       SETUP-DB.
      ******************************************************************

      *    SERVER
         MOVE  "<|DB_NAME|>@<|DB_HOST|>:<|DB_PORT|>"
           TO DBNAME.
         MOVE  "<|DB_USER|>"
           TO USERNAME.
         MOVE  "<|DB_PASSWORD|>"
           TO PASSWD.

           EXEC SQL
               CONNECT :USERNAME IDENTIFIED BY :PASSWD USING :DBNAME 
           END-EXEC.

           EXEC SQL
               DROP TABLE IF EXISTS EMP_FETCHLOOP
           END-EXEC.

           EXEC SQL
                CREATE TABLE EMP_FETCHLOOP
                (
                    EMP_NO     NUMERIC(4,0),
                    EMP_NAME   CHAR(20),
                    EMP_SALARY NUMERIC(4,0)
                )
           END-EXEC.

      *    INSERT ROWS USING HOST VARIABLE
           PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > 10
              MOVE TEST-NO(IDX)     TO  EMP-NO
              MOVE TEST-NAME(IDX)   TO  EMP-NAME
              MOVE TEST-SALARY(IDX) TO  EMP-SALARY
              EXEC SQL
                 INSERT INTO EMP_FETCHLOOP VALUES
                        (:EMP-NO,:EMP-NAME,:EMP-SALARY)
              END-EXEC
           END-PERFORM.

           EXEC SQL COMMIT WORK END-EXEC.

      ******************************************************************
       CLEANUP-DB.
      ******************************************************************

           EXEC SQL
               DROP TABLE IF EXISTS EMP_FETCHLOOP
           END-EXEC.

           EXEC SQL
               DISCONNECT ALL
           END-EXEC.

      ******************************************************************
       DISPLAY-TEST-RESULT.
      ******************************************************************
           IF  SQLCODE = ZERO
             THEN

               DISPLAY "<log> test case " TEST-CASE-COUNT ": success"
               ADD 1 TO TEST-CASE-COUNT

             ELSE
               DISPLAY "*** SQL ERROR ***"
               DISPLAY "SQLCODE: " SQLCODE " " NO ADVANCING
               EVALUATE SQLCODE
                  WHEN  +10
                     DISPLAY "Record not found"
                  WHEN  -01
                     DISPLAY "Connection falied"
                  WHEN  -20
                     DISPLAY "Internal error"
                  WHEN  -30
                     DISPLAY "PostgreSQL error"
                     DISPLAY "ERRCODE: "  SQLSTATE
                     DISPLAY SQLERRMC
                  *> TO RESTART TRANSACTION, DO ROLLBACK.
                     EXEC SQL
                         ROLLBACK
                     END-EXEC
                  WHEN  OTHER
                     DISPLAY "Undefined error"
                     DISPLAY "ERRCODE: "  SQLSTATE
                     DISPLAY SQLERRMC
               END-EVALUATE
               STOP RUN.
      ******************************************************************
])

AT_CHECK([${EMBED_DB_INFO} prog.cbl])
AT_CHECK([${COMPILE_MODULE} prog.cbl])
AT_CHECK([${RUN_MODULE} prog | tee stdout.txt], [0],
[<declare(valid)> SQLCODE:+000000000
<open(valid)> SQLCODE:+000000000
<fetch(valid)> SQLCODE:+000000000
<data(valid)> +0001, +0400
<fetch(valid)> SQLCODE:+000000000
<data(valid)> +0002, +0350
<fetch(valid)> SQLCODE:+000000000
<data(valid)> +0003, +0300
<fetch(valid)> SQLCODE:+000000000
<data(valid)> +0006, +0150
<fetch(valid)> SQLCODE:+000000000
<data(valid)> +0008, +0050
<fetch(valid)> SQLCODE:+000000000
<data(valid)> +0010, +0350
<fetch(valid)> SQLCODE:+000000100
<close(valid)> SQLCODE:+000000000
<declare(empty)> SQLCODE:+000000000
<open(empty)> SQLCODE:+000000000
<fetch(empty)> SQLCODE:+000000100
<close(empty)> SQLCODE:+000000000
<declare(invalid)> SQLCODE:+000000000
<open(invalid)> SQLCODE:-000009999
<fetch(invalid)> SQLCODE:-000009999
<close(invalid)> SQLCODE:+000000000
])

AT_CLEANUP