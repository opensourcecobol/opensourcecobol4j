AT_SETUP([COB_DATE])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  DATE-YMD.
         03  DATE-YY PIC X(2).
         03  DATE-MM PIC X(2).
         03  DATE-DD PIC X(2).
       PROCEDURE        DIVISION.
           ACCEPT DATE-YMD FROM DATE.
           DISPLAY DATE-YMD.
           GOBACK.
])

AT_CHECK([${COMPILE_JP_COMPAT} prog.cob])
AT_CHECK([COB_DATE=1970/01/02 java prog], [0], [700102
])

AT_CLEANUP


AT_SETUP([COB_DATE YYYYMMDD])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  DATE-YMD.
         03  DATE-YYYY PIC X(4).
         03  DATE-MM   PIC X(2).
         03  DATE-DD   PIC X(2).
       PROCEDURE        DIVISION.
           ACCEPT DATE-YMD FROM DATE YYYYMMDD.
           DISPLAY DATE-YMD.
           GOBACK.
])

AT_CHECK([${COMPILE_JP_COMPAT} prog.cob])
AT_CHECK([COB_DATE=1970/01/02 java prog], [0], [19700102
])

AT_CLEANUP

AT_SETUP([COB_DATE DAY])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  DAY-YD.
         03  DAY-YY PIC X(2).
         03  DAY-DD PIC X(3).
       PROCEDURE        DIVISION.
           ACCEPT DAY-YD FROM DAY.
           DISPLAY DAY-YD.
           GOBACK.
])

AT_CHECK([${COMPILE_JP_COMPAT} prog.cob])
AT_CHECK([COB_DATE=1970/02/01 java prog], [0], [70032
])

AT_CLEANUP

AT_SETUP([COB_DATE DAY YYYYDDD])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  DAY-YD.
         03  DAY-YYYY PIC X(4).
         03  DAY-DD   PIC X(3).
       PROCEDURE        DIVISION.
           ACCEPT DAY-YD FROM DAY YYYYDDD.
           DISPLAY DAY-YD.
           GOBACK.
])

AT_CHECK([${COMPILE_JP_COMPAT} prog.cob])
AT_CHECK([COB_DATE=1970/02/01 java prog], [0], [1970032
])

AT_CLEANUP

AT_SETUP([COB_DATE FUNC. CURRENT-DATE])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  CURR-DATE.
         03  CURR-YYYY PIC X(4).
         03  CURR-MM   PIC X(2).
         03  CURR-DD   PIC X(2).
         03  FILLER    PIC X(13).
       PROCEDURE        DIVISION.
           MOVE FUNCTION CURRENT-DATE TO CURR-DATE.
           DISPLAY CURR-YYYY CURR-MM CURR-DD.
           GOBACK.
])

AT_CHECK([${COMPILE_JP_COMPAT} prog.cob])
AT_CHECK([COB_DATE=1970/01/02 java prog], [0], [19700102
])

AT_CLEANUP

AT_SETUP([COB_DATE OUT-OF-RANGE DAY])

dnl A day beyond the end of the month is carried over to the next month,
dnl and both ACCEPT FROM DATE and FUNCTION CURRENT-DATE see the same date.

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  CURR-DATE.
         03  CURR-YYYYMMDD PIC X(8).
         03  FILLER        PIC X(13).
       01  DATE-YMD       PIC X(8).
       PROCEDURE        DIVISION.
           MOVE FUNCTION CURRENT-DATE TO CURR-DATE.
           ACCEPT DATE-YMD FROM DATE YYYYMMDD.
           DISPLAY CURR-YYYYMMDD.
           DISPLAY DATE-YMD.
           GOBACK.
])

AT_CHECK([${COMPILE_JP_COMPAT} prog.cob])
AT_CHECK([COB_DATE=2026/02/30 java prog], [0], [20260302
20260302
])
AT_CHECK([COB_DATE=2026/04/31 java prog], [0], [20260501
20260501
])

dnl February 29 exists only in a leap year. The Gregorian rule is left to
dnl the date library, so a century that is not a leap year is handled too.
AT_CHECK([COB_DATE=2024/02/29 java prog], [0], [20240229
20240229
])
AT_CHECK([COB_DATE=2026/02/29 java prog], [0], [20260301
20260301
])
AT_CHECK([COB_DATE=2000/02/29 java prog], [0], [20000229
20000229
])
AT_CHECK([COB_DATE=2100/02/29 java prog], [0], [21000301
21000301
])

AT_CLEANUP

AT_SETUP([COB_DATE FUNC. INVALID-ENV 1])

AT_DATA([prog.cob],[
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  CURR-DATE.
         03  CURR-YYYY PIC X(4).
         03  CURR-MM   PIC X(2).
         03  CURR-DD   PIC X(2).
         03  FILLER    PIC X(13).
       PROCEDURE        DIVISION.
           MOVE FUNCTION CURRENT-DATE TO CURR-DATE.
           DISPLAY CURR-YYYY CURR-MM CURR-DD.
           GOBACK.
])

AT_CHECK([${COMPILE_JP_COMPAT} prog.cob])
AT_CHECK([COB_DATE=1970 java prog > out1.txt], [0], [],
[Warning: COB_DATE format invalid, ignored.
])
AT_CHECK([date +%Y%m%d > out2.txt])
AT_CHECK([diff out1.txt out2.txt], [0])

AT_CLEANUP

AT_SETUP([COB_DATE FUNC. INVALID-ENV 2])

AT_DATA([prog.cob],[
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  CURR-DATE.
         03  CURR-YYYY PIC X(4).
         03  CURR-MM   PIC X(2).
         03  CURR-DD   PIC X(2).
         03  FILLER    PIC X(13).
       PROCEDURE        DIVISION.
           MOVE FUNCTION CURRENT-DATE TO CURR-DATE.
           DISPLAY CURR-YYYY CURR-MM CURR-DD.
           GOBACK.
])

AT_CHECK([${COMPILE_JP_COMPAT} prog.cob])
AT_CHECK([COB_DATE=1970/1/1 java prog > out1.txt], [0], [],
[Warning: COB_DATE format invalid, ignored.
])
AT_CHECK([date +%Y%m%d > out2.txt])
AT_CHECK([diff out1.txt out2.txt], [0])

AT_CLEANUP

AT_SETUP([COB_DATE FUNC. INVALID-ENV 3])

AT_DATA([prog.cob],[
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  CURR-DATE.
         03  CURR-YYYY PIC X(4).
         03  CURR-MM   PIC X(2).
         03  CURR-DD   PIC X(2).
         03  FILLER    PIC X(13).
       PROCEDURE        DIVISION.
           MOVE FUNCTION CURRENT-DATE TO CURR-DATE.
           DISPLAY CURR-YYYY CURR-MM CURR-DD.
           GOBACK.
])

AT_CHECK([${COMPILE_JP_COMPAT} prog.cob])
AT_CHECK([COB_DATE=10000/01/01 java prog > out1.txt], [0], [],
[Warning: COB_DATE format invalid, ignored.
])
AT_CHECK([date +%Y%m%d > out2.txt])
AT_CHECK([diff out1.txt out2.txt], [0])

AT_CLEANUP

AT_SETUP([COB_DATE FUNC. INVALID-ENV 4])

AT_DATA([prog.cob],[
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  CURR-DATE.
         03  CURR-YYYY PIC X(4).
         03  CURR-MM   PIC X(2).
         03  CURR-DD   PIC X(2).
         03  FILLER    PIC X(13).
       PROCEDURE        DIVISION.
           MOVE FUNCTION CURRENT-DATE TO CURR-DATE.
           DISPLAY CURR-YYYY CURR-MM CURR-DD.
           GOBACK.
])

AT_CHECK([${COMPILE_JP_COMPAT} prog.cob])
AT_CHECK([date +%Y%m%d > out2.txt])

dnl A month or a day outside its range is rejected, not carried over.
AT_CHECK([COB_DATE=2026/13/01 java prog > out1.txt], [0], [],
[Warning: COB_DATE format invalid, ignored.
])
AT_CHECK([diff out1.txt out2.txt], [0])

AT_CHECK([COB_DATE=2026/99/99 java prog > out1.txt], [0], [],
[Warning: COB_DATE format invalid, ignored.
])
AT_CHECK([diff out1.txt out2.txt], [0])

AT_CHECK([COB_DATE=2026/00/00 java prog > out1.txt], [0], [],
[Warning: COB_DATE format invalid, ignored.
])
AT_CHECK([diff out1.txt out2.txt], [0])

AT_CHECK([COB_DATE=2026/12/00 java prog > out1.txt], [0], [],
[Warning: COB_DATE format invalid, ignored.
])
AT_CHECK([diff out1.txt out2.txt], [0])

dnl Year 0 is 1 BCE in the ISO calendar, which no COBOL program means.
AT_CHECK([COB_DATE=0000/01/01 java prog > out1.txt], [0], [],
[Warning: COB_DATE format invalid, ignored.
])
AT_CHECK([diff out1.txt out2.txt], [0])

AT_CLEANUP

AT_SETUP([COB_DATE FUNC. CURRENT-DATE GMT offset])

dnl COB_DATE fixes the date only. The GMT offset keeps coming from the clock,
dnl so it stays at the offset in effect now, not the one of the fixed date.
dnl (Asia/Tokyo was at +0918 in 1880 and at +1000 in the summer of 1948.)
dnl Java reads the TZ environment variable on Unix only.
AT_SKIP_IF([test -n "$IS_WINDOWS"])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  CURR-DATE.
         03  FILLER    PIC X(16).
         03  CURR-GMT  PIC X(5).
       PROCEDURE        DIVISION.
           MOVE FUNCTION CURRENT-DATE TO CURR-DATE.
           DISPLAY CURR-GMT.
           GOBACK.
])

AT_CHECK([${COMPILE_JP_COMPAT} prog.cob])
AT_CHECK([TZ=Asia/Tokyo java prog], [0], [+0900
])
AT_CHECK([TZ=Asia/Tokyo COB_DATE=1880/01/01 java prog], [0], [+0900
])
AT_CHECK([TZ=Asia/Tokyo COB_DATE=1948/06/01 java prog], [0], [+0900
])

AT_CLEANUP

AT_SETUP([COB_DATE FUNC. CURRENT-DATE of time])

dnl This test uses GNU date -d and +%s which are not available on Windows.
AT_SKIP_IF([test -n "$IS_WINDOWS"])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  CURR-DATE.
         03  CURR-YYYY PIC 9(4).
         03  CURR-MM   PIC 9(2).
         03  CURR-DD   PIC 9(2).
         03  CURR-H    PIC 9(2).
         03  CURR-M    PIC 9(2).
         03  CURR-S    PIC 9(2).
         03  FILLER    PIC X(7).
       01 CMDLN.
         03  CMDLN-CMD  PIC X(18) VALUE 'expr \( `date +%s`';
         03  FILLER     PIC X(3)  VALUE ' - ';
         03  CMDLN-DT1  PIC X(8)  VALUE '`date -d';
         03  FILLER     PIC X(1)  VALUE "'";
         03  CMDLN-YYYY PIC 9(4);
         03  FILLER     PIC X(1)  VALUE '-';
         03  CMDLN-MM   PIC 9(2);
         03  FILLER     PIC X(1)  VALUE '-';
         03  CMDLN-DD   PIC 9(2);
         03  FILLER     PIC X(1)  VALUE ' ';
         03  CMDLN-H    PIC 9(2);
         03  FILLER     PIC X(1)  VALUE ':';
         03  CMDLN-M    PIC 9(2);
         03  FILLER     PIC X(1)  VALUE ':';
         03  CMDLN-S    PIC 9(2);
         03  FILLER     PIC X(1)  VALUE "'";
         03  CMDLN_DT2  PIC X(13) VALUE ' +%s` \) / 2';
       PROCEDURE        DIVISION.
           MOVE FUNCTION CURRENT-DATE TO CURR-DATE.
           MOVE CURR-YYYY TO CMDLN-YYYY.
           MOVE CURR-MM   TO CMDLN-MM.
           MOVE CURR-DD   TO CMDLN-DD.
           MOVE CURR-H    TO CMDLN-H.
           MOVE CURR-M    TO CMDLN-M.
           MOVE CURR-S    TO CMDLN-S.
           CALL "SYSTEM" USING CMDLN.
           GOBACK.
])

AT_CHECK([${COMPILE_JP_COMPAT} prog.cob])
AT_CHECK([COB_DATE=`date +%Y/%m/%d` java prog || true], [0], [0
])

AT_CLEANUP
