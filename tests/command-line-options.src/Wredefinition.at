AT_SETUP([-Wredefinition])

AT_DATA([prog.cbl], [
       IDENTIFICATION              DIVISION.	
       PROGRAM-ID.                 prog.	
       DATA DIVISION.
       WORKING-STORAGE             SECTION.	
       01 GRP.
         03 A PIC X(5).
       01 B redefines GRP.
         05 C PIC X(5).
       01 C  PIC X(5).
       PROCEDURE                   DIVISION.	
       MAIN-RTN.
           STOP RUN.	
])

AT_CHECK([${COBJ} -Wredefinition prog.cbl], [0], [],
[prog.cbl:10: Warning: Redefinition of 'C'
    8 |        01 B redefines GRP.
    9 |          05 C PIC X(5).
   10 >        01 C  PIC X(5).
   11 |        PROCEDURE                   DIVISION.
   12 |        MAIN-RTN.
prog.cbl:9: Warning: 'C' previously defined here
    7 |          03 A PIC X(5).
    8 |        01 B redefines GRP.
    9 >          05 C PIC X(5).
   10 |        01 C  PIC X(5).
   11 |        PROCEDURE                   DIVISION.
])

AT_CHECK([${COBJ} --help | grep '\-Wredefinition' > /dev/null], [0])
AT_CLEANUP
