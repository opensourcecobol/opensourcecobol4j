AT_SETUP([FD EXTERNAL nihongo])
export LC_ALL=''

AT_DATA([prog1.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog1.
       environment division.
       input-output section.
        file-control.
              select f assign to 'file.txt'
                organization is line sequential
                access mode is sequential.
       DATA DIVISION.
       file section.
       fd f is external.
       01 ＢＣ－１ pic x(5).
       working-storage section.
       01 ＢＣ－２ pic x(5) external.
       PROCEDURE DIVISION.
           initialize ＢＣ－１.
           initialize ＢＣ－２.

           open output f.
           call "sub".
           close f.

           open input f.
           read f.
           close f.

           display ＢＣ－１.
           display ＢＣ－２.
           STOP RUN.
])

AT_DATA([prog2.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog2 is initial.

       environment division.
       input-output section.
        file-control.
              select f assign to 'file.txt'
                organization is line sequential
                access mode is sequential.
       DATA DIVISION.
       file section.
       fd f is external.
       01 ＢＣ－１ pic x(5).
       working-storage section.
       01 ＢＣ－２ pic x(5) external.
       PROCEDURE DIVISION.
           initialize ＢＣ－１.
           initialize ＢＣ－２.

           open output f.
           call "sub".
           close f.

           open input f.
           read f.
           close f.

           display ＢＣ－１.
           display ＢＣ－２.
           STOP RUN.
])

AT_DATA([sub.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. sub.
       environment division.
       input-output section.
        file-control.
              select f assign to "file.txt"
                organization is line sequential
                access mode is sequential.
       DATA DIVISION.
       file section.
       fd f is external.
       01 ＢＣ－１ pic x(5).
       working-storage section.
       01 ＢＣ－２ pic x(5) external.
       PROCEDURE DIVISION.
           move "abcde" to ＢＣ－１.
           write ＢＣ－１.
           move "12345" to ＢＣ－２.
           goback.
])

AT_CHECK([${COBJ} prog1.cbl prog2.cbl sub.cbl])
AT_CHECK([java prog1], [0],
[abcde
12345
])

AT_CHECK([java prog2], [0],
[abcde
12345
])

AT_CLEANUP
